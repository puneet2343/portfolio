# Copy to .env.local for local dev, or add these in Vercel > Project > Settings > Environment Variables.

# Required: the single admin login for /admin
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-long-password
# Required: random string, at least 32 characters, used to sign the admin session cookie
SESSION_SECRET=generate-with-node-e-crypto-randomBytes-32

# Optional (production storage). If set, content + messages + page views are stored in MongoDB.
# Without it, local dev uses JSON files in ./data and production runs read-only on the bundled seed content.
MONGODB_URI=
MONGODB_DB=portfolio

# Optional (production uploads). Vercel Blob read/write token for image and resume uploads.
# Without it, local dev saves uploads to ./public/uploads.
BLOB_READ_WRITE_TOKEN=

# Optional: public site URL used for sitemap / Open Graph (else taken from admin SEO settings)
NEXT_PUBLIC_SITE_URL=
